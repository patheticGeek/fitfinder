// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/prisma-generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  password      UserPassword?
  organizations OrganizationUser[]
  resumes       Resume[]
  createdAt     DateTime           @default(now())
}

model UserPassword {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  hash      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id        String             @id @default(uuid())
  name      String
  members   OrganizationUser[]
  jobs      Job[]
  resumes   Resume[]
  createdAt DateTime           @default(now())
}

model OrganizationUser {
  id             String       @id @default(uuid())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  isAdmin        Boolean      @default(false)

  @@unique([userId, organizationId])
}

model Job {
  id                     String       @id @default(uuid())
  title                  String?
  description            String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId         String
  resumes                Resume[]
  additionalInstructions String?
  suggestedQuestions     String?
  createdAt              DateTime     @default(now())
}

model Resume {
  id                 String        @id @default(uuid())
  addedByUser        User?         @relation(fields: [addedByUserId], references: [id], onDelete: Cascade)
  addedByUserId      String?       @map("userId")
  job                Job?          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId              String?
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId     String?
  fileName           String
  score              Int?
  scoreJustification String?
  // Structured, AI-extracted sections
  education          Json? // Array of education entries
  experience         Json? // Array of experience entries with start/end dates
  projects           Json? // Array of projects

  // Candidate Q&A
  questionAnswers QuestionAnswer[]

  // Contact information
  email String?
  phone String?

  // Profile enrichments
  currentLocation       String?
  totalExperienceMonths Int? // Total experience in months for precision

  // Normalized skills linkage
  resumeSkills ResumeSkill[]
  createdAt    DateTime      @default(now())
}

model QuestionAnswer {
  id        String   @id @default(uuid())
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId  String
  question  String
  answer    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        String        @id @default(uuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  resumes   ResumeSkill[]
}

model ResumeSkill {
  id       String @id @default(uuid())
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId  String

  @@unique([resumeId, skillId])
}
